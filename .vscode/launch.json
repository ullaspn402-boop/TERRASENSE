{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (Python)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "jinja": true
    },
    {
      "name": "Next.js Frontend (Node)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "TerraSense Full Stack (FastAPI + Next.js)",
      "configurations": ["FastAPI Backend (Python)", "Next.js Frontend (Node)"],
      "stopAll": true
    }
  ]
}
